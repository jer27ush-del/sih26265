# Copy to .env and change the values. Never commit the real .env file.
DJANGO_SECRET_KEY=dev-secret-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Demo accounts and the role switcher. Set to 0 for any real deployment.
FDR_DEMO_MODE=1

DB_ENGINE=sqlite
POSTGRES_DB=aicte_fdr
POSTGRES_USER=aicte
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Where uploaded documents are stored. Keep this outside the public web folder.
PRIVATE_MEDIA_ROOT=./private_media

# Configure an SMTP server to deliver FDR maturity reminders to institution contact emails.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=jerushbabu88@gmail.com
EMAIL_HOST_PASSWORD=sxpz rbmj kvth gsyp
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=AICTE FDR Portal <jerushbabu88@gmail.com>
